# Binaries
backend/bin/
*.exe

# Local SQLite databases
*.db
*.db-journal
*.db-wal
*.db-shm

# Local attachment uploads (dev storage backend, STORAGE_LOCAL_DIR)
.uploads/

# Env
.env
.env.local

# Go
*.test
*.out
coverage.*

# Editor / OS
.DS_Store
.idea/
.vscode/

# Claude Code local config (skills, settings, session state)
.claude/
CLAUDE.md
tasks
issues

# Compiled web drop-in — build it: `cd web && npm run build` (or `make build`).
# The directory itself must stay tracked: //go:embed all:dist needs a file inside
# it to resolve, or `go build` breaks on a fresh clone.
backend/internal/webasset/dist/*
!backend/internal/webasset/dist/.gitkeep

# npm/yarn failure logs
npm-debug.log*
yarn-error.log*
