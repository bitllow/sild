# Sild backend configuration (all settings have defaults; SQLite needs none).

SILD_ENV=development
SILD_HTTP_ADDR=:8080
# PORT is injected by PaaS platforms (Cloud Run, Heroku, Fly) and wins over
# SILD_HTTP_ADDR. Leave it unset anywhere you choose the port yourself.
# PORT=8080

# Database: postgres | mysql | sqlite
DB_DRIVER=sqlite
DB_DSN=sild.db
DB_LOG_SQL=false

# Examples for other drivers:
# DB_DRIVER=postgres
# DB_DSN=host=localhost port=5432 user=sild password=sild dbname=sild sslmode=disable
# DB_DRIVER=mysql
# DB_DSN=sild:sild@tcp(localhost:3306)/sild?parseTime=true&charset=utf8mb4

# Email channel (§6.2). Each tenant gets a forwarding address
# <inbound_token>@$SILD_EMAIL_INBOUND_DOMAIN; orgs forward their support mailbox
# to it and the sild-mail daemon catches + ingests every message.
SILD_EMAIL_INBOUND_DOMAIN=inbound.sild.local
SILD_SMTP_ADDR=:2525
# Outbound relay for agent replies. Leave RELAY_ADDR empty to disable sending
# (the mailer becomes a no-op — fine for local dev). MailHog: localhost:1025.
# SILD_SMTP_RELAY_ADDR=localhost:1025
# SILD_SMTP_RELAY_USER=
# SILD_SMTP_RELAY_PASS=
SILD_SMTP_FROM=support@inbound.sild.local
# Run the receiver above in-process (sild-standalone) rather than as sild-mail.
# Off by default; PaaS targets use POST /v1/email/inbound instead.
SILD_SMTP_INGEST=false

# Background jobs (sild-worker, or in-process in sild-standalone). "" is a pure
# serving replica; unset takes the default below. See docs/deployment.md.
SILD_JOBS=webhook,archive

# First-tenant bootstrap for sild-standalone. `sild-admin tenant create` is the
# real mechanism; this is for platforms with no shell. See docs/deployment.md.
# SILD_BOOTSTRAP_TENANT=Acme
# SILD_BOOTSTRAP_ADMIN_EMAIL=you@acme.com
# SILD_BOOTSTRAP_ADMIN_NAME=Your Name
# SILD_BOOTSTRAP_ADMIN_PASSWORD=<clear this once you have signed in>

# Production refuses to start with settings that are silently single-node:
# the memory broker (events never leave the process), sqlite, and local storage
# without a signing key every replica shares.
# SILD_ENV=production
# SILD_BROKER=redis
# SILD_REDIS_URL=redis://localhost:6379
# STORAGE_SIGNING_KEY=<shared secret>

# Attachments and archived conversations (§11, §12). local keeps them on the
# node, so a deployment wants a bucket every process can reach; STORAGE_BUCKET
# has no default. Credentials come from ADC.
# STORAGE_BACKEND=gcs
# STORAGE_BUCKET=my-sild-uploads
